# =============================================================================
# E-Verify Platform - Environment Configuration
# =============================================================================

# Server Port
PORT=3000

# PostgreSQL Connection String (Port 5433 avoids conflicts with existing 5432 services)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/everify_db

# Connection Pool Settings
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000
DB_SSL=false

# Streaming ETL Configuration
ETL_BATCH_SIZE=1000
