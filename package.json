{
  "name": "e-verify-platform",
  "version": "1.0.0",
  "description": "Official-grade E-Verify & STEM OPT verification platform with streaming ETL and pg_trgm sub-15ms fuzzy search",
  "main": "dist/src/backend/server.js",
  "scripts": {
    "build": "tsc",
    "migrate": "node dist/src/etl/init-db.js",
    "etl": "ts-node src/etl/etl.ts",
    "sync": "ts-node src/sync/fetch-everify-export.ts",
    "start": "node dist/src/backend/server.js",
    "dev": "ts-node src/backend/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "e-verify",
    "stem-opt",
    "postgresql",
    "pg_trgm",
    "streaming-etl",
    "nestjs",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.3",
    "playwright": "^1.64.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
